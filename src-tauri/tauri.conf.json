{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HappyTool",
  "version": "1.5.5",
  "identifier": "com.happytool.light",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HappyTool",
        "width": 1400,
        "height": 900,
        "minWidth": 650,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0f19",
        "additionalBrowserArgs": "--enable-features=SharedArrayBuffer --disable-features=CalculateNativeWinOcclusion"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../important/**/*",
      "../server/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
